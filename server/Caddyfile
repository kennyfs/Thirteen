{$DOMAIN} {
	encode zstd gzip
	# The battle server: its WebSocket endpoint and a health check.
	@ws path /ws
	handle @ws {
		reverse_proxy thirteen:8080
	}
	handle /health {
		reverse_proxy thirteen:8080
	}
	# The web page (web/dist, in the image's /srv): a static site whose screens are in the address's fragment
	# (#/play), so a file that is not there is a 404.
	handle {
		root * /srv
		file_server
	}
	# Vite's files carry a hash of their content in their names: kept for good. The rest is checked each time.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@unhashed not path /assets/*
	header @unhashed Cache-Control "no-cache"
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
}
