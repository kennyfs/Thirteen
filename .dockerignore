# The server image needs cpp/, scripts/, protocol/ and server/; the site web/ too, with the app's strings (its ONNX
# Runtime and network come prebuilt from a release).
*
!cpp
!scripts
!protocol
!server
!web
# One line per language: the legacy builder (no BuildKit) drops a wildcard exception such as values*/strings.xml.
!android/app/src/main/res/values/strings.xml
!android/app/src/main/res/values-zh-rTW/strings.xml
!android/app/src/main/res/values-ja/strings.xml
!android/app/src/main/res/values-zh-rHK/strings.xml
!android/app/src/main/res/values-zh-rCN/strings.xml
!android/app/src/main/res/values-vi/strings.xml
!android/app/src/main/res/values-in/strings.xml
web/node_modules
web/dist
web/build
web/engine-files
web/src/generated
cpp/build*
cpp/external/onnxruntime
server/build
server/.gradle
server/models
protocol/build
**/.gradle
