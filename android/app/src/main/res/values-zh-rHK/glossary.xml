<?xml version="1.0" encoding="utf-8"?>
<resources>
  <string name="glossary_title">術語表</string>
  <string name="glossary_note">由道、牌型到打槍、首選</string>

  <string name="glossary_t_row">道（頭道、中道、尾道）</string>
  <string name="glossary_d_row">13 張牌分成的三組：頭道 3 張、中道 5 張、尾道 5 張。開牌後同每一位對手逐道比大小。</string>
  <string-array name="glossary_p_row"><item>頭道</item><item>中道</item><item>尾道</item><item>三道</item></string-array>
  <string name="glossary_t_rank">牌型</string>
  <string name="glossary_d_rank">一道牌的組合，由大到細：同花順、四條、夫佬（三條加一啤）、同花、蛇、三條、兩啤、一啤、散牌。牌型大的贏；牌型一樣就比點數，A 最大、2 最細，花色不分大小。頭道只有 3 張，所以只會係三條、一啤或散牌。</string>
  <string-array name="glossary_p_rank"><item>牌型</item><item>同花順</item><item>四條</item><item>夫佬</item><item>蛇</item><item>三條</item><item>兩啤</item><item>一啤</item><item>散牌</item></string-array>
  <string name="glossary_t_wheel">A-2-3-4-5</string>
  <string name="glossary_d_wheel">A 當作 1 用的蛇。各地計法不同：可以係最細的蛇、第二大的蛇，或者唔算蛇，喺「設定 › 規則」揀選。</string>
  <string-array name="glossary_p_wheel"><item>A-2-3-4-5</item></string-array>
  <string name="glossary_t_foul">倒水</string>
  <string name="glossary_d_foul">三道的大小必須係尾道唔細過中道、中道唔細過頭道，次序反轉就係倒水。倒水的擺法唔可以出。</string>
  <string-array name="glossary_p_foul"><item>倒水</item></string-array>
  <string name="glossary_t_strict">嚴格</string>
  <string name="glossary_d_strict">一種規則：兩道一樣大（牌型同點數都相同）亦算倒水，必須嚴格一道大過一道。</string>
  <string-array name="glossary_p_strict"><item>嚴格規則</item><item>嚴格</item></string-array>
  <string name="glossary_t_scoop">打槍</string>
  <string name="glossary_d_scoop">三道都贏過同一位對手，對方要額外多付分數，幾多視乎規則。相反三道都輸給對方，就係被打槍。</string>
  <string-array name="glossary_p_scoop"><item>打槍</item></string-array>
  <string name="glossary_t_home_run">通殺</string>
  <string name="glossary_d_home_run">一手牌同時對三位對手都打槍，每一家再多付分數。</string>
  <string-array name="glossary_p_home_run"><item>通殺</item></string-array>
  <string name="glossary_t_front_trips">頭道三條</string>
  <string name="glossary_d_front_trips">頭道擺三條。頭道只有 3 張，三條係頭道最大的牌型，好多規則會額外加分。</string>
  <string-array name="glossary_p_front_trips"><item>頭道三條</item></string-array>
  <string name="glossary_t_special">特殊牌型</string>
  <string name="glossary_d_special">擺喺某一道會額外加分的大牌型：頭道三條、中道夫佬、四條或同花順、尾道四條或同花順。視乎規則，可能不論輸贏每家都要付分，亦可能要贏過對方嗰一道先收分。</string>
  <string-array name="glossary_p_special"><item>特殊牌型</item></string-array>
  <string name="glossary_t_dragon">一條龍</string>
  <string name="glossary_d_dragon">13 張剛好係 2 到 A 各一張。只要冇倒水，依規則每一家都會額外付你分數。</string>
  <string-array name="glossary_p_dragon"><item>一條龍</item></string-array>
  <string name="glossary_t_network">神經網絡</string>
  <string name="glossary_d_network">電腦對手同分析用的模型：睇一手牌同某種擺法，估計咁擺平均可以拎幾分。佢係靠程式自己同自己對打大量牌局訓練出來的。</string>
  <string-array name="glossary_p_network"><item>神經網絡</item></string-array>
  <string name="glossary_t_q">Q（期望得分）</string>
  <string name="glossary_d_q">一種擺法平均可以拎到的分數，由神經網絡估計，假設三位對手都好似佢咁擺。正數代表平均贏分，負數代表平均輸分。</string>
  <string-array name="glossary_p_q"><item>期望得分</item><item>期望分</item><item>期望值</item></string-array>
  <string name="glossary_t_best">首選</string>
  <string name="glossary_d_best">Q 最高的擺法，亦即係 AI 認為最好的擺法。同首選差距極細（喺神經網絡誤差內）的擺法，可以當作一樣好。</string>
  <string-array name="glossary_p_best"><item>首選</item><item>最佳擺法</item></string-array>
  <string name="glossary_t_style">攻擊型、防守型</string>
  <string name="glossary_d_style">首選偏重的方向。攻擊型：大牌集中喺某一道，打槍多、被打槍亦多。防守型：三道較平均，被打槍少、打槍亦少。</string>
  <string-array name="glossary_p_style"><item>攻擊型</item><item>防守型</item></string-array>
  <string name="glossary_t_rows">搶道</string>
  <string name="glossary_d_rows">以多贏幾道為主、唔搏打槍的擺法。喺每道都計分的規則下較為重要。</string>
  <string-array name="glossary_p_rows"><item>搶道</item></string-array>
  <string name="glossary_t_indep">逐道獨立（indep）</string>
  <string name="glossary_d_indep">一種較簡單的電腦對手：將每一道分開估計贏的機率，唔考慮三道之間的關係。</string>
  <string-array name="glossary_p_indep"><item>逐道獨立（indep）</item><item>逐道獨立</item></string-array>
  <string name="glossary_t_mc">蒙地卡羅</string>
  <string name="glossary_d_mc">一種電腦對手：將每種擺法對上多副隨機發給對手的牌試算，揀平均最好的一種；對手的牌用逐道獨立的方式擺。</string>
  <string-array name="glossary_p_mc"><item>蒙地卡羅</item></string-array>
</resources>
