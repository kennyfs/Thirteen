<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon: a card and the edge of the one behind it (ic_launcher_foreground) on the felt. Adaptive, so the
     launcher cuts the felt to its own shape; a plain picture it would shrink onto a white plate. A test build has the
     felt and the cards at night (src/nightly). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@color/ic_launcher_background" />
  <foreground android:drawable="@drawable/ic_launcher_foreground" />
  <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
